rules_version = '2';

// CEVA tools — Firestore security rules for the shared Firebase project (ceva-tools).
// Covers every tool: the receiving dock board, the NCI/Grief inbound exceptions tool, the
// warehouse transactions dashboard, the inventory differences tool, the putaway audit tool and the
// inventory action tracker.
// Deployed with `firebase deploy --only firestore:rules`, or paste into
// Firebase console → Firestore Database → Rules → Publish.
//
// One people list for both tools, stored at roles/{uid}:
//   role    viewer     → see the dock board; see inbound issues; see the transactions dashboard
//           supervisor → also update trucks on the dock board; also work inbound issues; also load
//                        a new SAP export into the transactions dashboard
//           user       → work inbound issues (no dock board changes)
//           admin      → everything, plus settings and people
//   company ceva | partner (NCI/Grief) → which side of the inbound tool the person is on
// Anyone who signs in without a roles document sees nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }
    function me() { return get(roleDoc()).data; }
    function hasRole(roles) {
      return request.auth != null && exists(roleDoc()) && me().role in roles;
    }
    function isViewer()     { return hasRole(['viewer', 'supervisor', 'user', 'admin']); }
    function isSupervisor() { return hasRole(['supervisor', 'admin']); }
    function isUser()       { return hasRole(['user', 'supervisor', 'admin']); }
    function isAdmin()      { return hasRole(['admin']); }

    // ───────── Receiving dock board ─────────

    // Trucks on the board
    match /loads/{loadId} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.kind in ['drop', 'appt']
        && request.resource.data.status in ['scheduled', 'arrived', 'door', 'unloading', 'received']
        && request.resource.data.priority in [1, 2, 3]
        && request.resource.data.size() <= 20;
      allow delete: if isSupervisor();
    }

    // Notice, owner names, clock format
    match /board/{docId} {
      allow read: if isViewer();
      allow write: if isSupervisor() && request.resource.data.size() <= 20;
    }

    // ───────── NCI/Grief inbound exceptions ─────────

    function validIssue(d) {
      return d.status in ['open', 'resolved']
        && d.ball in ['ceva', 'partner']
        && d.priority in [1, 2, 3]
        && d.type in ['short', 'over', 'damage', 'wrong', 'noasn', 'label', 'late', 'other']
        && d.openedBy is map
        && d.openedBy.company in ['ceva', 'partner']
        && d.size() <= 32;
    }

    // One document per error shipment
    match /issues/{issueId} {
      allow read: if isViewer();
      allow create: if isUser()
        && validIssue(request.resource.data)
        && request.resource.data.openedBy.uid == request.auth.uid;
      allow update: if isUser()
        && validIssue(request.resource.data)
        && request.resource.data.openedBy == resource.data.openedBy
        && request.resource.data.openedAt == resource.data.openedAt;
      allow delete: if isAdmin();

      // Update thread. Entries are written once and never edited.
      match /updates/{updateId} {
        allow read: if isViewer();
        allow create: if isUser()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.company in ['ceva', 'partner']
          && request.resource.data.size() <= 12;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Outgoing notification emails, picked up by the optional "Trigger Email" extension.
    match /mail/{mailId} {
      allow create: if isUser() && request.resource.data.size() <= 6;
      allow read, update, delete: if false;
    }

    // ───────── Warehouse transactions dashboard ─────────

    // wtdays/{YYYY-MM-DD} is one summary per confirmation date: counts per associate, activity,
    // process type and hour, kept as JSON text. History builds up as exports are loaded.
    // Anyone with a role reads; supervisors and admins load; admins can remove a day.
    match /wtdays/{day} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.date == day
        && request.resource.data.by == request.auth.uid
        && request.resource.data.cube is string
        && request.resource.data.cube.size() < 1000000
        && request.resource.data.size() <= 14;
      allow delete: if isAdmin();
    }

    // wt/open is the summary of the open task list from the most recent export (who, when, how
    // many parts). wt/open/chunks/{version}_{n} hold those task lines as JSON text, split to stay
    // under Firestore's 1 MiB document limit.
    match /wt/{docId} {
      allow read: if isViewer();
      allow write: if isSupervisor()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.chunks is int
        && request.resource.data.chunks <= 40
        && request.resource.data.size() <= 12;

      match /chunks/{chunkId} {
        allow read: if isViewer();
        allow create, update: if isSupervisor()
          && request.resource.data.rows is string
          && request.resource.data.rows.size() < 1000000
          && request.resource.data.size() <= 3;
        allow delete: if isSupervisor();
      }
    }

    // ───────── Inventory differences ─────────

    // invdays/{YYYY-MM-DD} holds the differences confirmed on that date (warehouse task lines whose
    // difference quantity is not zero), as JSON text. Loading an export adds to a day, so the list
    // builds up. Anyone with a role reads; supervisors and admins load; admins can remove a day.
    match /invdays/{day} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.date == day
        && request.resource.data.by == request.auth.uid
        && request.resource.data.rows is string
        && request.resource.data.rows.size() < 1000000
        && request.resource.data.size() <= 10;
      allow delete: if isAdmin();
    }

    // invact/{task|product|bin} is the action on one difference: status, owner and notes.
    // Supervisors and admins work them.
    match /invact/{actId} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status in ['new', 'recount', 'research', 'post', 'closed']
        && request.resource.data.owner is string && request.resource.data.owner.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.size() <= 12;
      allow delete: if isAdmin();
    }

    // invcfg/settings holds the priority thresholds (quantity limits for P1 and P2).
    match /invcfg/{docId} {
      allow read: if isViewer();
      allow write: if isAdmin() && request.resource.data.size() <= 10;
    }

    // ───────── Putaway audit ─────────

    // putdays/{YYYY-MM-DD} holds the putaways out of the goods receipt zone confirmed on that date,
    // as JSON text. Loading an export adds to a day. Anyone with a role reads; supervisors and
    // admins load; admins can remove a day.
    match /putdays/{day} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.date == day
        && request.resource.data.by == request.auth.uid
        && request.resource.data.rows is string
        && request.resource.data.rows.size() < 1000000
        && request.resource.data.size() <= 10;
      allow delete: if isAdmin();
    }

    // putaud/{task|product} is the audit result on one putaway: correct or error, what was wrong,
    // notes and the associate it belongs to. Supervisors and admins enter them.
    match /putaud/{audId} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.res in ['none', 'ok', 'error']
        && request.resource.data.type in ['', 'bin', 'qty', 'prod', 'missing', 'label', 'damage', 'other']
        && request.resource.data.who is string && request.resource.data.who.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.size() <= 14;
      allow delete: if isAdmin();
    }

    // ───────── Inventory action tracker ─────────

    // atrk/{id} is one action of the Inventory Action Tracker: number, category, action item, details,
    // owner, frequency, priority, start and due date, status, percent complete and notes.
    // Anyone with a role reads; supervisors and admins add and update; admins can delete.
    match /atrk/{actId} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.n is int && request.resource.data.n > 0
        && request.resource.data.item is string && request.resource.data.item.size() > 0 && request.resource.data.item.size() <= 200
        && request.resource.data.det is string && request.resource.data.det.size() <= 2000
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.own is string && request.resource.data.own.size() <= 300
        && request.resource.data.status in ['Not Started', 'In Progress', 'Complete', 'On Hold', 'Blocked', 'Cancelled']
        && request.resource.data.pri in ['', 'High', 'Medium', 'Low']
        && request.resource.data.freq in ['', 'One-time', 'Daily', 'Weekly', 'Monthly', 'Ongoing']
        && request.resource.data.pct is int && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
        && request.resource.data.size() <= 16;
      allow delete: if isAdmin();
    }

    // atrklog/{id} is one line of the tracker's update log: date, action number, update, updated by.
    match /atrklog/{logId} {
      allow read: if isViewer();
      allow create, update: if isSupervisor()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.size() <= 8;
      allow delete: if isAdmin();
    }

    // atrkcfg/settings holds the site name shown on the tracker and in its Excel export.
    match /atrkcfg/{docId} {
      allow read: if isViewer();
      allow write: if isAdmin() && request.resource.data.size() <= 6;
    }

    // ───────── Shared ─────────

    // admin/brand (dock board site name and TV colors), admin/settings (inbound company names, emails, SLA)
    match /admin/{docId} {
      allow read: if isViewer();
      allow write: if isAdmin() && request.resource.data.size() <= 20;
    }

    // Who can use the tools. Each person can read their own role.
    match /roles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.role in ['viewer', 'supervisor', 'user', 'admin']
        && (!('company' in request.resource.data) || request.resource.data.company in ['ceva', 'partner'])
        && request.resource.data.size() <= 10;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Access requests. Anyone who signs up can file one request for themselves; admins approve
    // (which creates the roles document and removes the request) or decline.
    match /requests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.company in ['ceva', 'partner']
        && request.resource.data.size() <= 8;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
